# ============================================================================
# KONFIGURASI KREDENSIAL & API KEY - RISET KELUHAN SAMPAH KOTA PALEMBANG
# Salin file ini menjadi .env dan isi sesuai kebutuhan pengujian Anda
# ============================================================================

# 1. KONFIGURASI AI / LLM (Digunakan untuk Normalisasi Bahasa Palembang, Zero-Shot Sentiment & NER)
# Pilih provider: "gemini", "openai", atau "offline_fallback"
AI_PROVIDER=offline_fallback
GEMINI_API_KEY=masukkan_api_key_google_gemini_studio_anda_disini
OPENAI_API_KEY=masukkan_api_key_openai_anda_disini
AI_MODEL_NAME=gemini-1.5-flash

# 2. KONFIGURASI SCRAPING INSTAGRAM (Instaloader / Apify)
# Gunakan akun Instagram khusus riset (dummy/second account), JANGAN akun utama!
IG_USERNAME=username_ig_riset_anda
IG_PASSWORD=password_ig_riset_anda
APIFY_API_TOKEN=masukkan_token_apify_jika_pakai_apify

# 3. KONFIGURASI SCRAPING YOUTUBE (YouTube Data API v3 - Google Cloud Console)
YOUTUBE_API_KEY=masukkan_youtube_data_api_key_anda

# 4. KONFIGURASI SCRAPING X / TWITTER (Tweet-Harvest / Twikit)
TWITTER_AUTH_TOKEN=masukkan_cookie_auth_token_twitter_anda
TWITTER_USERNAME=username_twitter_riset
TWITTER_PASSWORD=password_twitter_riset

# 5. KONFIGURASI SCRAPING META THREADS (threads.net)
# Gunakan akun dummy/riset Instagram/Threads atau Cookie sessionid dari threads.net
THREADS_USERNAME=username_threads_riset_anda
THREADS_PASSWORD=password_threads_riset_anda
THREADS_SESSION_ID=masukkan_cookie_sessionid_threads_anda

# 6. KONFIGURASI MODEL HUGGINGFACE (Jurnal 1 - IndoBERT & BERTopic)
# Set USE_TRANSFORMERS=true jika sudah install torch, transformers, dan bertopic
USE_TRANSFORMERS=true
INDOBERT_MODEL_PATH=mdhugol/indonesia-bert-sentiment-classification

# 6. KONFIGURASI GEOCODING & RENTANG TAHUN DATA (Jurnal 1 & Jurnal 2)
# User-Agent wajib diisi untuk OpenStreetMap Nominatim API
OSM_USER_AGENT=RisetSampahPalembang_Jurnal/1.0
GOOGLE_MAPS_API_KEY=opsional_jika_pakai_google_maps_geocoding
DATA_START_YEAR=2024
DATA_END_YEAR=2026
